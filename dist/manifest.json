{
  "manifest_version": 3,
  "name": "DeepSeek Chat Exporter",
  "version": "1.0.0",
  "default_locale": "en",
  "description": "Export DeepSeek chat conversations to Word, PDF, HTML, Markdown, JSON, PNG, and SVG formats",
  "browser_specific_settings": {
    "gecko": {
      "id": "deepseek-exporter@example.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "DeepSeek Chat Exporter",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["page_inject.js"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content_script.js"]
    }
  ]
}
