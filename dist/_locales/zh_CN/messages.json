  "guideStep1Title": {
    "message": "打开一个对话",
    "description": "指南步骤 1 标题"
  },
  "guideStep1Desc": {
    "message": "在 chat.deepseek.com 上打开一个对话，扩展将自动加载消息并在切换对话时保持同步。",
    "description": "指南步骤 1 说明"
  },
  "guideStep2Title": {
    "message": "选择消息",
    "description": "指南步骤 2 标题"
  },
  "guideStep2Desc": {
    "message": "勾选消息旁的选择框来选中需要导出的消息。使用「全选」「清空」「反选」快速管理选择。你可以按角色（用户/助手）或关键词筛选消息。",
    "description": "指南步骤 2 说明"
  },
  "guideStep3Title": {
    "message": "选择导出格式",
    "description": "指南步骤 3 标题"
  },
  "guideStep3Desc": {
    "message": "选择 Word、PDF、HTML、Markdown、JSON、PNG 或 SVG 格式。展开「高级选项」可自定义页面大小、方向、代码高亮主题等。",
    "description": "指南步骤 3 说明"
  },
  "guideStep4Title": {
    "message": "导出并保存",
    "description": "指南步骤 4 标题"
  },
  "guideStep4Desc": {
    "message": "点击「导出」按钮生成并下载文件。处理大对话时会在后台运行以保持扩展响应流畅。",
    "description": "指南步骤 4 说明"
  }
